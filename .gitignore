.DS_Store

# Bulky, regenerable per-seed artifacts (checkpoints, raw prediction dumps) --
# NOT the graded run logs. Kept out of git; reproducible by re-running.
logs/artifacts/
# Quarantined hidden-test metrics. Must never be committed -- this is the
# firewalled data the whole harness exists to keep out of the loop, and that
# includes keeping it out of the graded repo.
logs/quarantine/

# logs/runs.jsonl, logs/registry.json, logs/orchestrator_state.json, and
# logs/coding_agent_usage.jsonl are the graded run logs (Deliverable 3) --
# intentionally NOT ignored. They used to be excluded by logs/*.jsonl and
# logs/*.json here; that was a bug (see AUDIT-1), not a policy.

# Solution dirs the CodingAgent generates per attempt (each one holds a copy
# of the vendored harness + a generated train.py). Reproducible from the log.
solutions/
